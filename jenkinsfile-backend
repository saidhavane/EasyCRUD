pipeline {
    agent {
        label 'worker'
    }

    tools {
        maven 'mvn'
    }

    environment{
        my_aws_cred = credentials('aws-access')
        ECR_REPO = '954475336500.dkr.ecr.ap-south-1.amazonaws.com/backend'
    }

    stages{
        stage ('checkout'){
            steps {
                git branch: 'main', url: 'https://github.com/saidhavane/EasyCRUD.git'
            }
        }
        stage ('build'){
            steps {
                dir ('backend'){
                    sh 'mvn clean package'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'backend/target/*.jar', fingerprint: true
                }
            }
        }
        stage ('artifact to s3') {
            steps{ 
                sh '''
                   sudo snap install aws-cli --classic
                   aws s3 cp backend/target/*.jar s3://easycrude-2003/Artifact/student.war
                   '''
            }
        } 
        stage ('sonarqube analysis') {
            steps {
                dir ('backend'){
                    withSonarQubeEnv('sonar'){
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        } 
        stage ('Quality gates'){
            steps {
                timeout(time: 5, unit: 'MINUTES'){
                     waitForQualityGate abortPipeline: true

                }
            }
        }  
         stage ('docker -build'){
            steps {
                dir('backend'){
                    sh'''
                      docker build -t backend:${BUILD_NUMBER} .
                      docker images
                      '''
                }
            }
         }
         stage ('push to ecr'){
            steps {
                sh'''
                  aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin 954475336500.dkr.ecr.ap-south-1.amazonaws.com
                  docker tag backend:${BUILD_NUMBER} ${ECR_REPO}:${BUILD_NUMBER}
                  docker push ${ECR_REPO}:${BUILD_NUMBER}
                '''
            }
            }
            stage ('update manifest'){
                steps{
                    sh '''
                      sed -i "s|image: .*|image: ${ECR_REPO}:${BUILD_NUMBER}|" k8s/backend/backend-deployment.yaml

                    '''
                }
            }
            stage ('push change to github'){
                steps{ 
                     withCredentials([
                    usernamePassword(
                        credentialsId: "github-cred",
                        usernameVariable: "GIT_USERNAME",
                        passwordVariable: "GIT_PASSWORD"
                    )
                     ]){
                        sh'''
                        git config user.name "saidhavane"
                        git config user.email "dhavanesp2003@gmail.com"

                        git add k8s/backend/backend-deployment.yaml
                        git commit -m "update k8s deployment"
                        git push https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/saidhavane/EasyCRUD.git HEAD:main
                        '''
                     }

                }
            }
             stage('Update Argocd') {
            steps {
                sh '''
                sudo aws eks update-kubeconfig --name my-eks-cluster1 --region us-west-2
                sudo kubectl apply -f argocd/backend-application.yaml
                sudo kubectl get application -n argocd
                '''
            }
        }
    }

    post {
        success {
          cleanWs()
        }
    }
}
         
    
