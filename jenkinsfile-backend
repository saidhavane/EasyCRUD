pipeline {
    agent {
        label 'worker'
    }

    tools {
        maven 'mvn'
    }

    environment{
        my_aws_cred = credentials('aws-access')
    }

    stages{
        stage ('checkout'){
            steps {
                git branch: 'main', url: 'https://github.com/saidhavane/EasyCRUD.git'
            }
        }
        stage ('build'){
            steps {
                dir ('backend'){
                    sh 'mvn clean package'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'backend/target/*.jar', fingerprint: true
                }
            }
        }
        stage ('artifact to s3') {
            steps{ 
                sh '''
                   sudo snap install aws-cli --classic
                   aws s3 cp backend/target/*.jar s3://easycrude-2003/Artifact/student.war
                   '''
            }
        }              
    }
}