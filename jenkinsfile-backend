pipeline {
    agent {
        label 'worker'
    }

    tools {
        maven 'mvn'
    }

    environment{
        my_aws_cred = credentials('aws-access')
    }

    stages{
        stage ('checkout'){
            steps {
                git branch: 'main', url: 'https://github.com/saidhavane/EasyCRUD.git'
            }
        }
        stage ('build'){
            steps {
                dir ('backend'){
                    sh 'mvn clean package'
                }
            }
        }
        post {
            success {
                archiveArtifacts artifact: 'backend/target/*.jar', fingerprint: true
            }
        }
                       
    }
}