pipeline {
    agent {
        label 'worker'
    }
    tools {
        maven 'mvn'
    }
    stages{
        stage ('checkout'){
            steps {
                git branch: 'main', url: 'https://github.com/saidhavane/EasyCRUD.git'
            }
        }
        stage ('build'){
            steps {
                dir ('backend'){
                    sh 'mvn clean package'
                }
            }
        }
                       
    }
}